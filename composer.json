{
    "name": "realitaa/phpvite",
    "description": "Modern Plain PHP + Vite 8 Vanilla JS Starter Template",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Realitaa\\PhpVite\\": "app/"
        },
        "files": [
            "app/Vite/helpers.php"
        ]
    },
    "require": {
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "spatie/fork": "^1.2"
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/dev.php"
        ],
        "test": "phpunit"
    }
}
